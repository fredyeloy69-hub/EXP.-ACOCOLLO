import * as XLSX from 'xlsx';

export async function generarReporteExcelPorArea(nombreTitulo, visibles) {
    const datosMapeados = visibles.map(c => ({
        "Área": c.area || "Sin área",
        "Nombre de Carpeta": c.nombre || "",
        "Ruta Completa": c.ruta || "",
        "Estado": c.estado || "",
        "Archivos Necesarios": c.archivosNecesarios || 0,
        "Archivos Completados": c.archivosCompletados || 0,
        "Marcada Manualmente": c.forzada ? "Sí" : "No",
        "Marcada Por": c.marcadoPor || ""
    }));

    const worksheet = XLSX.utils.json_to_sheet(datosMapeados);
    const workbook = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(workbook, worksheet, "Reporte Filtrado");
    
    XLSX.writeFile(workbook, `Reporte_${nombreTitulo.replace(/[^a-zA-Z0-9]/g, '_')}.xlsx`);
}
