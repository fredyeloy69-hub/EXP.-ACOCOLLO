import jsPDF from 'jspdf';
import 'jspdf-autotable';

// Función para exportar la vista filtrada actual
export function generarReportePorArea(nombreTitulo, visibles, opciones = {}) {
    const doc = new jsPDF();
    const usuarioFirma = opciones.usuarioFirma || "Sistema Acocollo I-2";

    doc.setFontSize(16);
    doc.text(nombreTitulo, 14, 20);
    
    doc.setFontSize(10);
    doc.text(`Generado por: ${usuarioFirma}`, 14, 28);
    doc.text(`Fecha: ${new Date().toLocaleDateString("es-PE")}`, 14, 34);

    const tableColumn = ["Área", "Carpeta / Especialidad", "Estado", "Progreso Archivos"];
    const tableRows = [];

    visibles.forEach(c => {
        const rowData = [
            c.area || "Sin área",
            c.nombre || "",
            c.estado || "",
            `${c.archivosCompletados || 0}/${c.archivosNecesarios || 0}`
        ];
        tableRows.push(rowData);
    });

    doc.autoTable({
        head: [tableColumn],
        body: tableRows,
        startY: 40,
        styles: { fontSize: 8 },
        headStyles: { fillColor: [229, 184, 11] }
    });

    doc.save(`Reporte_${nombreTitulo.replace(/[^a-zA-Z0-9]/g, '_')}.pdf`);
}

